__pycache__
FreeBodyEngine.egg-info/
/build/
/site/
/assets/cache/

# Stray wrangler CLI cache (account id/email) - never meant to live in
# this repo, picked up from a `wrangler` command run with this as cwd.
/.wrangler/

# compile_cpp_scripts()' own generated output directory (cli/cpp/compile.py:
# the compiled _fbcpp.*.so, its generated bind/module .cpp, the .py/.pyi
# shims, setup.py, and the machine-local content-hash cache data.json) -
# entirely regenerated by `fb compile_scripts` / scripts/build_native.py
# from the real source (a `native/*.hpp` file's own `//@bind` markers),
# never hand-edited. Applies wherever this dir shows up - the engine's own
# ui/native/cpp_scripts/ and any project's code/cpp_scripts/ alike.
**/cpp_scripts/
