@input
vertex: vec3
uvs: vec2
normal: vec3
vertex_color: vec4
vertex_px_range: float

@output
uv: vec2
frag_color: vec4
frag_px_range: float

# vertex_color/vertex_px_range are per-vertex now (baked in by
# TextRenderer.queue_text(), 4 identical copies per glyph quad) instead of
# the old text_color/px_range uniforms - see TextRenderer's own module
# docstring: this is what lets many different strings, in different
# colors/sizes, batch into one shared draw call instead of one per string,
# as long as they share the same font atlas texture (the one thing that
# genuinely can't vary within a single draw call).
def main() -> void:
    VERTEX_POSITION = vec4(vertex.x, vertex.y, 0.0, 1.0)
    uv = uvs
    frag_color = vertex_color
    frag_px_range = vertex_px_range
