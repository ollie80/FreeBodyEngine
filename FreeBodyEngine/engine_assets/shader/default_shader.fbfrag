# The G-buffer write for an opaque surface.
#
# ALBEDO, NORMAL, EMMISIVE, ROUGHNESS and METALLIC are material properties,
# not uniforms this shader declares: MaterialInjector rewrites each one into
# the texture-or-colour branch for that property and injects the uniforms it
# needs (see graphics/material.py). Adding a property to the material adds it
# here for free.

@output
albedo: vec4
normal: vec4
emmisive: vec4
roughness: float
metallic: float
gWorldPos: vec4
gWorldNormal: vec4

@input
uv: vec2
worldPos: vec4
worldNormal: vec4

def main() -> void:
    albedo = ALBEDO
    normal = NORMAL
    emmisive = EMMISIVE
    roughness = ROUGHNESS
    metallic = METALLIC

    # Passed straight through from the vertex stage into their own G-buffer
    # channels - `gWorldPos.w`/`gWorldNormal.w` are both a constant 1.0
    # sentinel a lighting pass can use to tell "real geometry was rasterized
    # here" apart from background pixels the cleared framebuffer never
    # touched (those read back as 0 in every channel, .w included).
    n: vec3 = normalize(vec3(worldNormal.x, worldNormal.y, worldNormal.z))
    gWorldPos = worldPos
    gWorldNormal = vec4(n.x, n.y, n.z, 1.0)
