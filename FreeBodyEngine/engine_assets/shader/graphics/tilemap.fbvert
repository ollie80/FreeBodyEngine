@input
vertex: vec4
uv: vec2

@uniform
proj: mat4
view: mat4
model: mat4
chunk_pos: vec2

@output
texcoord: vec2
image_id: flat int
spritesheet_id: flat int

def main():
    texcoord = uv
    image_id = round(vertex.z)
    spritesheet_id = round(vertex.w)
    chunk_world_pos: vec2 = vec2(chunk_pos.x * float(_ENGINE_CHUNK_WORLD_SIZE), chunk_pos.y * float(_ENGINE_CHUNK_WORLD_SIZE))
    VERTEX_POSITION = proj * view * model * vec4(vertex.xy + chunk_world_pos, 0.0, 1.0)
